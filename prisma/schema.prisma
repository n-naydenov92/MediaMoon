generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELLED
}

enum FileStatus {
  QUEUED
  UPLOADING
  UPLOADED
  PUBLISHING
  DONE
  FAILED
}

enum CtaType {
  LEARN_MORE
  SHOP_NOW
  SIGN_UP
}

model Job {
  id            String    @id @default(cuid())
  brandId       String
  market        String
  accountId     String
  campaignId    String
  adSetId       String
  pageId        String
  copyHeadline  String
  copyBody      String
  copyUrl       String
  copyCta       CtaType
  status        JobStatus @default(QUEUED)
  batchNumber   Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  files         JobFile[]

  @@index([brandId, createdAt(sort: Desc)])
  @@index([status])
}

model JobFile {
  id           String     @id @default(cuid())
  jobId        String
  job          Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  originalName String
  mimeType     String
  sizeBytes    Int
  blobUrl      String?
  status       FileStatus @default(QUEUED)
  progress     Float      @default(0)
  adId         String?
  creativeId   String?
  mediaId      String?
  error        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([jobId])
  @@index([status])
}
