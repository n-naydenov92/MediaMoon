# Anthropic (Claude API)
ANTHROPIC_API_KEY=

# NewsAPI (newsapi.org — free tier: 100 req/day)
NEWS_API_KEY=

# SearchAPI.io — Google News keyword search (free: 100 req/month, paid: $49/mo for 5000)
# Solves the RSS "firehose" problem: finds articles by keyword regardless of site publish volume
SEARCH_API_KEY=

# Clerk (Auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Meta Marketing API — System User tokens, one per Business Manager
# Generated in Business Settings → Users → System Users → Generate Token
# Scopes: ads_management, ads_read, business_management, pages_read_engagement
META_TOKEN_STOITCHKOV=
META_TOKEN_THEGREENBEAR=
META_TOKEN_THEGREENBEAR_2=
META_TOKEN_SAPPHIRE=

# Neon Postgres
# DATABASE_URL = pooled connection (PgBouncer) — for Prisma runtime queries
# DIRECT_URL   = direct connection — for Prisma migrations (DDL not supported through pooler)
DATABASE_URL=
DIRECT_URL=

# Vercel Blob (file staging for Launch tab uploads)
# Generated automatically when a Blob store is created in the Vercel dashboard
BLOB_READ_WRITE_TOKEN=

# Inngest (background worker for Launch tab queue)
# Auto-injected by the Vercel <-> Inngest integration; pull locally with `vercel env pull .env.local`
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
