# Anthropic (Claude API)
ANTHROPIC_API_KEY=

# NewsAPI (newsapi.org — free tier: 100 req/day)
NEWS_API_KEY=

# SearchAPI.io — Google News keyword search (free: 100 req/month, paid: $49/mo for 5000)
# Solves the RSS "firehose" problem: finds articles by keyword regardless of site publish volume
SEARCH_API_KEY=

# Clerk (Auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Meta Marketing API — System User tokens, one per Business Manager
# Generated in Business Settings → Users → System Users → Generate Token
# Scopes: ads_management, ads_read, business_management, pages_read_engagement
META_TOKEN_STOITCHKOV=
META_TOKEN_THEGREENBEAR=
META_TOKEN_THEGREENBEAR_2=
META_TOKEN_SAPPHIRE=

# WooCommerce REST API — per-brand store credentials
# Generated in WordPress admin → WooCommerce → Settings → Advanced → REST API → Add Key
# Permissions: Read (we only fetch reports/orders, never write)
WOO_URL_SAPPHIRE=
WOO_KEY_SAPPHIRE=
WOO_SECRET_SAPPHIRE=
WOO_URL_THEGREENBEAR=
WOO_KEY_THEGREENBEAR=
WOO_SECRET_THEGREENBEAR=

# Klaviyo — Private API key per brand (each brand has its own Klaviyo account)
# Generated in Klaviyo → Settings → API Keys → Create Private API Key
# Scopes: Campaigns (read), Flows (read), Metrics (read)
# The Placed Order metric ID is auto-discovered from /api/metrics/ at runtime.
KLAVIYO_API_KEY_THEGREENBEAR=
KLAVIYO_API_KEY_SAPPHIRE=
KLAVIYO_API_KEY_STOITCHKOV=

# Google Analytics 4 — service account JSON (single line) shared across brands
# 1) GCP Console → enable "Google Analytics Data API"
# 2) Create a service account, download a JSON key, paste the entire contents here as one line
# 3) In each brand's GA4 → Admin → Property Access Management, add the service-account email as Viewer
# 4) Property IDs are numeric (~9 digits); leave a brand blank if it has no GA4 yet
GOOGLE_SERVICE_ACCOUNT_JSON=
GA_PROPERTY_ID_STOITCHKOV=
GA_PROPERTY_ID_THEGREENBEAR=
GA_PROPERTY_ID_SAPPHIRE=

# Neon Postgres
# DATABASE_URL = pooled connection (PgBouncer) — for Prisma runtime queries
# DIRECT_URL   = direct connection — for Prisma migrations (DDL not supported through pooler)
DATABASE_URL=
DIRECT_URL=

# Vercel Blob (file staging for Launch tab uploads)
# Generated automatically when a Blob store is created in the Vercel dashboard
BLOB_READ_WRITE_TOKEN=

# Inngest (background worker for Launch tab queue)
# Auto-injected by the Vercel <-> Inngest integration; pull locally with `vercel env pull .env.local`
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
